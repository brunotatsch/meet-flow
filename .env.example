NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# "local" faz bun run dev subir Supabase via Docker e ignora as URLs abaixo.
# Use "remote" para apontar a um projeto Supabase de desenvolvimento já hospedado.
DEV_DATABASE_MODE=local

# APP_URL já é permitida. Separe origens adicionais por vírgula, sem path.
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info
GLOBAL_RATE_LIMIT_MAX=300
GLOBAL_RATE_LIMIT_WINDOW_MS=60000

# Usadas somente com DEV_DATABASE_MODE=remote e em Preview/Production.
# Supabase > Connect > Transaction pooler (porta 6543).
DATABASE_URL=postgresql://postgres.example:change-me@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase > Connect > Direct connection. Em redes sem IPv6, use o Session pooler na porta 5432.
DIRECT_DATABASE_URL=postgresql://postgres:change-me@db.example.supabase.co:5432/postgres?sslmode=require

# Gere um valor novo por ambiente: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000

# Stripe (modo teste em desenvolvimento). Nunca versione chaves reais.
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_PRICE_STARTER=price_change_me_starter
STRIPE_PRICE_PRO=price_change_me_pro

# Mínimo 32 caracteres; enviado como Authorization: Bearer pelo Supabase Cron.
CRON_SECRET=cron-secret-change-me-0123456789abcdef

# E-mails transacionais. Em desenvolvimento, use "disabled" para registrar a
# entrega sem chamar a rede; em produção configure Resend e um domínio verificado.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=re_change_me
EMAIL_FROM="MeetFlow <reservas@example.com>"

# Assina links públicos de cancelamento. A rotação invalida links ainda ativos.
BOOKING_CANCELLATION_SECRET=cancel-secret-change-me-0123456789abcdef
