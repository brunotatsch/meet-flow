{
  "name": "meet-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "bun build src/services/http/server.ts --outdir dist --target bun",
    "start": "bun run dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.services.json --noEmit",
    "test": "bun --bun vitest run --config vitest.config.ts",
    "test:watch": "bun --bun vitest --config vitest.config.ts",
    "test:e2e": "bun --bun vitest run --config vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bash scripts/migration-run.sh",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "better-auth": "1.6.27",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@eslint/js": "10.0.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
