{
  "name": "meet-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "bun build src/services/http/server.ts --outdir dist --target bun",
    "build:web": "vite build --config vite.web.config.ts",
    "start": "bun run dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.services.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "bun --bun vitest run --config vitest.config.ts",
    "test:watch": "bun --bun vitest --config vitest.config.ts",
    "test:web": "bun --bun vitest run --config vitest.web.config.ts",
    "test:web:watch": "bun --bun vitest --config vitest.web.config.ts",
    "test:e2e": "bun --bun vitest run --config vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bash scripts/migration-run.sh",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run scripts/seed-dev.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "better-auth": "1.6.27",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.3",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/bun": "1.3.14",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jiti": "2.7.0",
    "jsdom": "30.0.1",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
