{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@web/*": ["src/web/src/*"]
    }
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.tsx"]
}
